# formasaita.ru: одно зеркало для поисковиков — https без www, без /index.html.
# Apache стоит за nginx: %{HTTPS} здесь ненадёжен (давал бесконечный 301), смотрим на X-Forwarded-Proto.
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://formasaita.ru%{REQUEST_URI} [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
